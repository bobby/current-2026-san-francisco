    {
      "id": 5,
      "type": "stat",
      "title": "Alerts suppressed",
      "description": "Alerts in groups the triage agent judged transient or expected.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-db"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT a) AS \"suppressed\" FROM signals, jsonb_array_elements_text(event->'alert_event_ids') a WHERE disposition = 'suppress' AND $__timeFilter(ts)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
