          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Alerts in vs. signals out, per minute",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-db"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), count(*) AS \"alerts in\" FROM alerts WHERE status = 'firing' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), count(*) AS \"signals raised\" FROM signals WHERE disposition = 'raise' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "barAlignment": 0,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "none",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alerts in"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d24b4b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "signals raised"
            },
            "properties": [
              {
