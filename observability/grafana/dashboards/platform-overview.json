{
  "uid": "platform-overview",
  "title": "Platform overview",
  "description": "Alerts in vs. signals out, and the starring jobs, annotated with deployments and actions (docs/design.md §9.3). Provisioned from observability/grafana/dashboards: edit the file, not the UI.",
  "tags": [
    "platform"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deployments",
        "enable": true,
        "iconColor": "#2f6fdb",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "ops-db"
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, job_name || ': ' || coalesce(from_version, '∅') || ' → ' || to_version || ' (' || kind || ', ' || outcome || ', by ' || triggered_by || ')' AS text, 'deploy,' || job_name AS tags FROM deployments WHERE $__timeFilter(ts) AND regexp_replace(job_name, '[^A-Za-z0-9:_]', '_', 'g') IN (${job:sqlstring}) ORDER BY ts"
        }
      },
      {
        "name": "Agent and human actions",
        "enable": true,
        "iconColor": "#e3a21a",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "ops-db"
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, job_name || ': ' || replace(action, '_', ' ') || ' ' || phase || ' by ' || actor AS text, 'action,' || phase AS tags FROM actions WHERE $__timeFilter(ts) AND regexp_replace(job_name, '[^A-Za-z0-9:_]', '_', 'g') IN (${job:sqlstring}) ORDER BY ts"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "custom",
        "multi": true,
        "includeAll": false,
        "allowCustomValue": true,
        "query": "payments-enrichment : payments_enrichment, trade-events-ingest : trade_events_ingest, market-data-to-iceberg : market_data_to_iceberg, positions-aggregator : positions_aggregator",
        "options": [
          {
            "text": "payments-enrichment",
            "value": "payments_enrichment",
            "selected": true
          },
          {
            "text": "trade-events-ingest",
            "value": "trade_events_ingest",
            "selected": true
          },
          {
            "text": "market-data-to-iceberg",
            "value": "market_data_to_iceberg",
            "selected": true
          },
          {
            "text": "positions-aggregator",
            "value": "positions_aggregator",
            "selected": true
          }
        ],
        "current": {
          "text": [
            "payments-enrichment",
            "trade-events-ingest",
            "market-data-to-iceberg",
            "positions-aggregator"
          ],
          "value": [
            "payments_enrichment",
            "trade_events_ingest",
            "market_data_to_iceberg",
            "positions_aggregator"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Alerts in vs. signals out",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alerts in",
      "description": "Alerts that fired in the time range: the raw firehose in #platform-alerts.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-db"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"alerts\" FROM alerts WHERE status = 'firing' AND $__timeFilter(ts)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#d24b4b"
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Signals raised",
      "description": "Alert groups the triage agent raised to #platform-signals.",
