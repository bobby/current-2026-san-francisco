# Copy to .env (git-ignored) to override local defaults. Every variable is
# optional: compose.yml has a working default for each one.

# Local S3-compatible store (RustFS) credentials, shared by Flink and the
# Iceberg REST catalog.
# S3_ACCESS_KEY=platform
# S3_SECRET_KEY=platform-secret

# Postgres superuser and per-service database passwords.
# POSTGRES_PASSWORD=postgres
# OPS_DB_PASSWORD=ops
# TICKETS_DB_PASSWORD=tickets
# MATTERMOST_DB_PASSWORD=mattermost

# Flink TaskManager sizing.
# FLINK_TM_SLOTS=12
# FLINK_TM_PROCESS_SIZE=2816m
