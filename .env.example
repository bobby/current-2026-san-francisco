# Copy to .env (git-ignored) to override local defaults. Every variable is
# optional: compose.yml has a working default for each one.

# Local S3-compatible store (RustFS) credentials, shared by Flink and the
# Iceberg REST catalog.
# S3_ACCESS_KEY=platform
# S3_SECRET_KEY=platform-secret

# Postgres superuser and per-service database passwords.
# POSTGRES_PASSWORD=postgres
# OPS_DB_PASSWORD=ops
# TICKETS_DB_PASSWORD=tickets
# MATTERMOST_DB_PASSWORD=mattermost
# ICEBERG_DB_PASSWORD=iceberg
# GRAFANA_DB_PASSWORD=grafana
# ASSISTANT_DB_PASSWORD=assistant

# How long the ops DB keeps Flink logs.
# LOG_RETENTION=24h

# Flink TaskManager sizing.
# FLINK_TM_SLOTS=12
# FLINK_TM_PROCESS_SIZE=2816m

# Secrets for the agents and services (#5 onwards). `make secrets-aws` copies
# the ones that are set to SSM Parameter Store for the cloud runtime.
# JEV_API_KEY=
# Jev's API: TypeSafe's by default, or an OpenJev/SemIf server with the same API.
# JEV_BASE_URL=https://api.typesafe.ai
# ANTHROPIC_API_KEY=
# The model @ops-assistant (Claude Code) uses.
# CLAUDE_MODEL=claude-sonnet-5-5
# The on-call engineer's Mattermost login (user `oncall`, created on first
# start) and Grafana's admin password. Grafana's dashboard needs no login.
# MATTERMOST_ADMIN_PASSWORD=oncall-demo-2026
# GRAFANA_ADMIN_PASSWORD=admin

# Where people reach the UIs, for links on Mattermost cards and Open Graph
# tags. The AWS tunnel forwards the same ports, so the defaults work there too.
# MATTERMOST_PUBLIC_URL=http://localhost:8065
# GRAFANA_PUBLIC_URL=http://localhost:3000
# TICKETS_PUBLIC_URL=http://localhost:8094

# Cloud runtime (scripts/aws.sh). AWS_PROFILE is read from the shell
# environment or this file (without it, the AWS CLI's default credentials);
# the others only from the shell environment.
# AWS_PROFILE=my-profile
# AWS_REGION=us-east-1
# AWS_STACK=current2026-demo
